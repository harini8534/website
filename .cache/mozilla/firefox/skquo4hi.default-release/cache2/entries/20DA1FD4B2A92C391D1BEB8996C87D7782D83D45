var SecondaryTopNavBar = {
  _element: document.querySelector('.secondary-top-nav-bar'),
  _leftScrollBtnElm: null,
  _rightScrollBtnElm: null,
  _location: null,
  _scrollSpeed: 1,
  _scrollInterval: null,
  _debug: null,
  _billingBaseUrl: 'https://billing.w3schools.com',
  _dashboardBaseUrl: 'https://pathfinder.w3schools.com',
  _orderBaseUrl: 'https://order.w3schools.com',
  _groupsApiBaseUrl: 'https://groups-api.w3sapi.com',
  _currentScrollableElement: null, // Add reference to currently scrollable element

  // Mouse drag scrolling variables
  _activateDragScroll: 0,
  _fromScrollPos: -1,
  _currentScrollPos: -1,
  _gotoTut: 1,
};

window.SecondaryTopNavBar = SecondaryTopNavBar;

SecondaryTopNavBar._isDebugMode = function () {
  if (SecondaryTopNavBar._debug !== null) {
    return SecondaryTopNavBar._debug;
  }

  if (
    localStorage.getItem('SecondaryTopNavBar.debug') === 'true'
  ) {
    SecondaryTopNavBar._debug = true;
  } else {
    SecondaryTopNavBar._debug = false;
  }

  return SecondaryTopNavBar._debug;
};

SecondaryTopNavBar._logDebug = function (message, data) {
  if (!SecondaryTopNavBar._isDebugMode()) {
    return;
  }

  if (typeof data === 'undefined') {
    console.log('SecondaryTopNavBar -> ' + message);
  } else {
    console.log('SecondaryTopNavBar -> ' + message, data);
  }
}

SecondaryTopNavBar._findInnerElements = function (parentElement, queryStr, callback) {
  var output = [];

  var hasCallback = typeof callback !== 'undefined';

  var elements = parentElement.querySelectorAll(queryStr);

  for (var index = 0; index < elements.length; index++) {
    output.push(elements[index]);

    if (hasCallback) {
      callback(elements[index], index);
    }
  }

  return output;
};

SecondaryTopNavBar._getCurrentScrollableElement = function () {
  // Find the currently visible wrapper element
  var networkWrapper = SecondaryTopNavBar._element.querySelector('.stnb-inner-wrapper[data-origin="network"]');
  var classicWrapper = SecondaryTopNavBar._element.querySelector('.stnb-inner-wrapper[data-origin="classic"]');

  // Return the visible wrapper (the one without w3-hide class)
  if (networkWrapper && !networkWrapper.classList.contains('w3-hide')) {
    return networkWrapper;
  } else if (classicWrapper && !classicWrapper.classList.contains('w3-hide')) {
    return classicWrapper;
  }

  // Fallback to main element if no wrapper is visible
  return SecondaryTopNavBar._element;
};

// Mouse drag scrolling functions
SecondaryTopNavBar._startDragScroll = function (event) {
  event.preventDefault();
  SecondaryTopNavBar._fromScrollPos = event.clientX;
  SecondaryTopNavBar._activateDragScroll = 1;
};

SecondaryTopNavBar._dragScroll = function (event) {
  SecondaryTopNavBar._currentScrollPos = event.clientX;
  if (SecondaryTopNavBar._currentScrollPos == SecondaryTopNavBar._fromScrollPos) return false;
  event.preventDefault();
  if (event.buttons == 0) return false;

  var scrollspeed;
  if (SecondaryTopNavBar._activateDragScroll == 1) {
    SecondaryTopNavBar._gotoTut = 0;
    scrollspeed = SecondaryTopNavBar._currentScrollPos - SecondaryTopNavBar._fromScrollPos;
    scrollspeed = Math.abs(scrollspeed);

    var elm = SecondaryTopNavBar._getCurrentScrollableElement();

    if (SecondaryTopNavBar._currentScrollPos < SecondaryTopNavBar._fromScrollPos) {
      elm.scrollLeft += scrollspeed;
    } else {
      elm.scrollLeft -= scrollspeed;
    }

    SecondaryTopNavBar._updateScrollBtnElmsVisibility();
    SecondaryTopNavBar._fromScrollPos = SecondaryTopNavBar._currentScrollPos;
  }
};

SecondaryTopNavBar._endDragScroll = function (event) {
  event.preventDefault();
  SecondaryTopNavBar._activateDragScroll = 0;
  SecondaryTopNavBar._fromScrollPos = -1;
  SecondaryTopNavBar._currentScrollPos = -1;
};

SecondaryTopNavBar._preventClickDuringDrag = function (event) {
  if (SecondaryTopNavBar._gotoTut == 0) {
    event.preventDefault();
    SecondaryTopNavBar._gotoTut = 1;
    return false;
  }
};

