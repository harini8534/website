// Main initialization function
async function initializePricingPage() {
  try {
    showLoader();
    disableButtons();
    const plusButton = document.querySelector('.get_w3schools_plus');
    const fullAccessButton = document.querySelector('.full-access-btn');
    const freeButton = document.querySelector('.free-btn');
    const toggle = document.getElementById('planToggle');

    // Helper: Set all buttons to login/signup
    function setAllButtonsToLogin() {
      const isYearly = toggle && toggle.checked;
      const loginUrl = getLoginUrl(isYearly);
      const plusButtons = document.querySelectorAll('.get_w3schools_plus');
      const fullAccessButtons = document.querySelectorAll('.full-access-btn');
      const freeButtons = document.querySelectorAll('.free-btn');
      plusButtons.forEach(btn => {
        if (btn) {
          btn.href = loginUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        }
      });
      fullAccessButtons.forEach(btn => {
        if (btn) {
          btn.href = loginUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        }
      });
      freeButtons.forEach(btn => {
        if (btn) {
          btn.href = loginUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        }
      });
    }

    // Helper: Set all buttons to /billing
    function setAllButtonsToBilling() {
      const billingUrl = getPathfinderBillingUrl();
      const plusButtons = document.querySelectorAll('.get_w3schools_plus');
      const fullAccessButtons = document.querySelectorAll('.full-access-btn');
      const freeButtons = document.querySelectorAll('.free-btn');
      plusButtons.forEach(btn => {
        if (btn) {
          btn.href = billingUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        }
      });
      fullAccessButtons.forEach(btn => {
        if (btn) {
          btn.href = billingUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        }
      });
      freeButtons.forEach(btn => {
        if (btn) {
          btn.href = billingUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        }
      });
    }

    // Helper: Set button(s) to checkout
    function setButtonToCheckout(buttons, product) {
      if (!buttons) return;
      if (NodeList.prototype.isPrototypeOf(buttons) || Array.isArray(buttons)) {
        buttons.forEach(btn => {
          btn.href = '#';
          btn.classList.remove('btn-disabled');
          btn.onclick = function (e) {
            e.preventDefault();
            handlePlanPurchase(product);
          };
        });
      } else {
        buttons.href = '#';
        buttons.classList.remove('btn-disabled');
        buttons.onclick = function (e) {
          e.preventDefault();
          handlePlanPurchase(product);
        };
      }
    }

    // Helper: Set button(s) to /billing
    function setButtonToBilling(buttons) {
      const billingUrl = getPathfinderBillingUrl();
      if (!buttons) return;
      if (NodeList.prototype.isPrototypeOf(buttons) || Array.isArray(buttons)) {
        buttons.forEach(btn => {
          btn.href = billingUrl;
          btn.onclick = null;
          btn.classList.remove('btn-disabled');
        });
      } else {
        buttons.href = billingUrl;
        buttons.onclick = null;
        buttons.classList.remove('btn-disabled');
      }
    }

    // Helper: Disable button(s)
    function disableButton(buttons) {
      if (!buttons) return;
      if (NodeList.prototype.isPrototypeOf(buttons) || Array.isArray(buttons)) {
        buttons.forEach(btn => {
          btn.classList.add('btn-disabled');
          btn.onclick = null;
          btn.href = '#';
        });
      } else {
        buttons.classList.add('btn-disabled');
        buttons.onclick = null;
        buttons.href = '#';
      }
    }

    // Check for accessToken
    const accessToken = getAccessToken();
    if (!accessToken) {
      // Not logged in: all buttons go to login/signup
      setAllButtonsToLogin();
      enableButtons();
      setupPlanButtons();
      hideLoader();

      return;
    }

    // Fetch user account and full access status in parallel
    const [userAccount, fullAccessStatus] = await Promise.all([fetchUserAccount(), fetchFullAccessStatus()]);
    // Use new plan detection with both values
    const planInfo = detectPlanType(userAccount, fullAccessStatus);

    // Button logic
    const plusButtons = document.querySelectorAll('.get_w3schools_plus');
    const fullAccessButtons = document.querySelectorAll('.full-access-btn');
    const freeButtons = document.querySelectorAll('.free-btn');

    if (planInfo.type === 'free') {
      // Free user: Plus and Full Access enabled, Free button goes to /billing
      setButtonToCheckout(plusButtons, toggle && toggle.checked ? 'plus_yearly' : 'plus_monthly');
      setButtonToCheckout(fullAccessButtons, 'full-access-course');
      setButtonToBilling(freeButtons);
    } else if (planInfo.type === 'plus_monthly' || planInfo.type === 'plus_yearly') {
      // Plus user: Only Full Access enabled, others go to /billing
      setButtonToBilling(plusButtons);
      setButtonToCheckout(fullAccessButtons, 'full-access-course');
      setButtonToBilling(freeButtons);

      // if (userAccount?.currentSubscription?.status === 'trialing') {
      //   showFreeTrialBadge();
      // }
    } else if (planInfo.type === 'full_access') {
      // Full access: all buttons go to /billing
      setAllButtonsToBilling();
    } else {
      // Fallback: all buttons to billing
      setAllButtonsToBilling();
    }

    updateCurrentPlanButtons(planInfo.type, userAccount);

    hideLoader();
    enableButtons();
    setupPlanButtons();
  } catch (error) {
    hideLoader();
    enableButtons();
    setupPlanButtons();
  }
}

