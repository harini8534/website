// Helper to make authenticated API calls to billing API
async function apiFetch(endpoint, options = {}) {
  const token = getAccessToken();
  if (!token) throw new Error('No access token found');

  const baseUrl = getBillingApiUrl();
  const url = `${baseUrl}${endpoint}`;

  const headers = options.headers ? { ...options.headers } : {};
  headers['Authorization'] = `Bearer ${token}`;

  return fetch(url, { ...options, headers });
}

// Function to fetch user's current plan from account API
async function fetchUserAccount() {
  try {
    const response = await apiFetch('/api/v3/account');
    if (!response.ok) {
      throw new Error('Failed to fetch user account');
    }
    const data = await response.json();
    return data;
  } catch (error) {
    console.error('Error fetching user account:', error);
    return null;
  }
}

// Function to create Stripe checkout session
async function createCheckoutSession(product) {
  try {
    const token = getAccessToken();
    if (!token) throw new Error('No access token found');

    const checkoutUrl = getCheckoutApiUrl();
    const url = `${checkoutUrl}/create-checkout-session`;

    let promoCode = 'BLACKWEEK25PLUS';

    if (product === 'full-access-course') {
      promoCode = 'BLACKWEEK25FULLACCESS';
    } else if (product === 'plus_yearly') {
      promoCode = 'BLACKWEEK25PLUSYEARLY';
    }

    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
      },
      body: JSON.stringify({ product, promoCode }),
    });

    if (!response.ok) {
      throw new Error('Failed to create checkout session');
    }

    const data = await response.json();
    return data.url; // Return the Stripe checkout URL
  } catch (error) {
    console.error('Error creating checkout session:', error);
    throw error;
  }
}

// Function to handle plan purchase
async function handlePlanPurchase(product) {
  try {
    // Show loader during checkout session creation
    showLoader();

    const checkoutUrl = await createCheckoutSession(product);

    // Redirect to Stripe checkout
    window.location.href = checkoutUrl;
  } catch (error) {
    console.error('Error handling plan purchase:', error);
    hideLoader();
    // You can add error handling UI here if needed
    alert('Failed to create checkout session. Please try again.');
  }
}

// Function to fetch user's full access status
async function fetchFullAccessStatus() {
  try {
    const token = getAccessToken();
    if (!token) throw new Error('No access token found');
    const baseUrl = getFullAccessApiUrl();
    const url = `${baseUrl}/pathfinder/profile-api/full-access`;
    const response = await fetch(url, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (!response.ok) throw new Error('Failed to fetch full access status');
    const data = await response.json();
    return data;
  } catch (error) {
    console.error('Error fetching full access status:', error);
    return null;
  }
}

