// Utility: Detect plan type from API response and full access status
function detectPlanType(userAccount, fullAccessStatus) {
  // Check full access first
  if (fullAccessStatus && fullAccessStatus.hasFullAccess) {
    return { type: 'full_access', name: 'Full Access', priceSlug: 'full-access-course' };
  }
  if (!userAccount || !userAccount.currentPlan) {
    return { type: 'free', name: 'Free', priceSlug: 'free' };
  }
  const plan = userAccount.currentPlan;
  const priceSlug = plan.priceSlug || plan;
  const name = plan.name || 'Free';
  // Plus plans
  if (priceSlug === 'plus-monthly') {
    return { type: 'plus_monthly', name: name, priceSlug: priceSlug };
  }
  if (priceSlug === 'plus-yearly') {
    return { type: 'plus_yearly', name: name, priceSlug: priceSlug };
  }
  // Free plans
  if (
    priceSlug === 'free-daily' ||
    priceSlug === 'free-monthly' ||
    priceSlug === 'free-yearly' ||
    priceSlug === 'free' ||
    name.toLowerCase().includes('free') ||
    plan.amount === 0
  ) {
    return { type: 'free', name: name, priceSlug: priceSlug };
  }
  // Fallback to free
  return { type: 'free', name: name, priceSlug: priceSlug };
}

