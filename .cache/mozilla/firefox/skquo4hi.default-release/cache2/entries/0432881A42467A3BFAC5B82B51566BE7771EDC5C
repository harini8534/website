  border-bottom-left-radius: 16px;
  border-bottom-right-radius: 16px;
}

.compare-table th.plus-plus {
  background: none;
  padding: 0;
  margin: 0;
  border: none;
  vertical-align: middle;
  position: relative;
  overflow: hidden;
}

